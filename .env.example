# Discord Bot Token (required)
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# OpenRouter API Key (for fallback LLM)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Admin Channel ID (optional)
# Channel where admin commands are visible and allowed
# To get: Enable Developer Mode in Discord, right-click channel, Copy Channel ID
ADMIN_CHANNEL_ID=

# Attendance Channel ID (optional)
# Channel where students submit attendance with /here command
ATTENDANCE_CHANNEL_ID=

# Auto-Response Channels (optional)
# Comma-separated channel IDs where bot responds without @mention
# Example: NL_ROUTING_CHANNELS=123456789,987654321
NL_ROUTING_CHANNELS=

# Explain Feature Channels (optional)
# Channel where admin threads are created for content creation conversations
EXPLAIN_ADMIN_CHANNEL_ID=
# Channel where generated educational content is posted (e.g., #ai-tutor)
AI_TUTOR_CHANNEL_ID=

# Google Sheets Backup (optional)
# Setup instructions:
# 1. Go to: https://console.cloud.google.com/
# 2. Create a new project (or use existing)
# 3. Enable APIs: Google Sheets API and Google Drive API
# 4. Create OAuth 2.0 credentials:
#    - Go to: APIs & Services > Credentials
#    - Click: Create Credentials > OAuth client ID
#    - Application type: Desktop app
#    - Name: Chibi Bot (or any name)
# 5. Download the credentials JSON file
# 6. Save to: credentials/google_oauth_credentials.json
# 7. First time running /export-progress: browser will open for OAuth consent
# 8. After consent, token.json will be saved automatically for future use

# Backup Notification Channel (optional)
# Channel where daily backup notifications are posted (for automated backups)
# To get: Enable Developer Mode in Discord, right-click channel, Copy Channel ID
BACKUP_NOTIFICATION_CHANNEL_ID=
